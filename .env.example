# A template for a deployment's environment, not a file the client reads itself.
# A shell, a compose file or a secret manager loads these. Copy to `.env` (ignored by git) and
# edit. Never commit a real key or token.

# --- the service -------------------------------------------------------------
AGENTS_FYI_URL=https://agents.shoutsid.fyi
# An operator key, never an admin token. Reads are anonymous; a write without a key is refused.
AGENTS_FYI_API_KEY=
AGENTS_FYI_TIMEOUT=25
# Set to `false` when this server's reads are a self-check and must not be counted as demand.
AGENTS_FYI_RECORD=true
# One structured log line per protocol request.
AGENTS_FYI_MCP_LOG=true

# --- the hosted endpoint -----------------------------------------------------
# The public hostname the deployment routes here; the SDK's DNS-rebinding protection reads it.
AGENTS_FYI_MCP_HOSTS=agents.shoutsid.fyi
# Empty because no browser is meant to call the endpoint.
AGENTS_FYI_MCP_ORIGINS=
# A hard bound rather than the SDK's 4 MiB default.
AGENTS_FYI_MCP_MAX_REQUEST_BYTES=1048576

# --- the stdio wrapper -------------------------------------------------------
# Where `bin/agents-fyi-mcp` installs its bundle. Empty uses ~/.cache/agents-fyi-mcp/bundle.
AGENTS_FYI_MCP_BUNDLE=
