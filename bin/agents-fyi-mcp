#!/usr/bin/env ruby
# frozen_string_literal: true

# The stdio entrypoint every caller names: `.mcp.json`, the harness's generated opencode
# configuration, and a person at a shell.
#
# **It is a script rather than a `bundle exec` array because two of the three callers launch a
# command array with no shell.** A single path is the simplest thing all three can name, and the
# bundle is this file's job rather than theirs: `BUNDLE_GEMFILE` is set here, so the SDK is found
# without the caller knowing where the component's Gemfile is.
#
# **The bundle lives outside the checkout by default.** A `vendor/bundle` in the tree is a second
# copy of a lockfile's answer that a build can accidentally ship; `~/.cache/agents-fyi-mcp` is a
# cache, and `AGENTS_FYI_MCP_BUNDLE` (or `BUNDLE_PATH`) points it somewhere else when a machine
# wants to. `scripts/dev.sh mcp` installs to the same default, so a local run and this entrypoint
# agree without either one configuring the other.
root = File.expand_path("..", __dir__)
ENV["BUNDLE_GEMFILE"] ||= File.join(root, "Gemfile")
ENV["BUNDLE_PATH"] ||= ENV["AGENTS_FYI_MCP_BUNDLE"] ||
  File.join(Dir.home, ".cache", "agents-fyi-mcp", "bundle")

require "bundler/setup"

$LOAD_PATH.unshift(File.join(root, "lib"))
require "agents_fyi_mcp"

AgentsFyiMcp.main
